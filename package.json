    "url": "git+https://github.com/drizza-dev/drizza.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "bin": {
    "drizza": "./dist-node/cli/index.js"
  },
  "files": [
    "dist",
    "dist-node",
    "skills"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "~22.13.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
