    "briefing",
    "mcp",
    "github",
    "claude-code",
    "codex",
    "local-first"
  ],
  "homepage": "https://docs.drizza.dev",
  "bugs": {
    "url": "https://github.com/drizza-dev/drizza/issues"
  },
  "repository": {
