{
  "contract_version": "1",
  "tools": [
    {
      "name": "push_briefing",
      "title": "Push briefing",
      "description": "Store the briefing for one day in drizza. A second push for the same date replaces the previous one.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "1"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Day the briefing belongs to, as YYYY-MM-DD."
          },
          "agent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Name of the agent that wrote the briefing."
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "bullets": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 30,
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "links": {
                        "type": "array",
                        "maxItems": 10,
                        "items": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2048,
                              "pattern": "^https?://",
                              "description": "Absolute http or https URL of the source."
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "source": {
                              "type": "string",
                              "enum": [
                                "slack",
                                "github",
                                "other"
                              ]
                            }
                          },
                          "required": [
                            "url",
                            "label",
                            "source"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "item_refs": {
                        "type": "array",
                        "maxItems": 10,
                        "items": {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 32
                            },
                            "external_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          },
                          "required": [
                            "source",
                            "external_id"
                          ],
                          "additionalProperties": false
                        },
                        "description": "Items this bullet refers to, by the same source and external_id used by push_items."
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "title",
                "bullets"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "contract_version",
          "date",
          "agent",
          "headline",
          "sections"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "briefing_id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "replaced": {
            "type": "boolean"
          }
        },
        "required": [
          "briefing_id",
          "date",
          "replaced"
        ]
      }
    },
    {
      "name": "push_items",
      "title": "Push items",
      "description": "Store items such as threads or pull requests in drizza. Items are matched by source and external_id, so pushing the same item again updates it. Pull requests synced from GitHub use source \"github\" and external_id \"owner/repo#number\"; pushing that key enriches the synced item with your summary and keeps its title, url and updated_at.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "1"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "description": "Where the item comes from, such as github or slack. Same value item_refs uses in push_briefing."
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "description": "What the item is, such as pull_request or thread."
                },
                "external_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "Identifier of the item inside its source. For GitHub pull requests, owner/repo#number."
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^https?://",
                  "description": "Absolute http or https URL of the item, without credentials."
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "description": "Short summary written by the agent."
                },
                "updated_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
                  "description": "When the item last changed in its source, as an RFC 3339 timestamp."
                }
              },
              "required": [
                "source",
                "kind",
                "external_id",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "contract_version",
          "items"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "inserted": {
            "type": "integer",
            "description": "Items that did not exist before this push."
          },
          "updated": {
            "type": "integer",
            "description": "Items that already existed, including synced items enriched with a summary. inserted plus updated equals the number of items pushed."
          }
        },
        "required": [
          "inserted",
          "updated"
        ]
      }
    },
    {
      "name": "get_today",
      "title": "Get today",
      "description": "Read what drizza already has for a day before pushing a new briefing. Without date, the day is today in the local time zone of the machine running drizza, not UTC.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "1"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Day to read, as YYYY-MM-DD. Defaults to today in the local time zone of the machine running drizza (not UTC)."
          }
        },
        "required": [
          "contract_version"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Day that was read, as YYYY-MM-DD in the local time zone of the machine running drizza."
          },
          "briefing": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "briefing_id": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "headline": {
                "type": "string"
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "bullets": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 30,
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          "links": {
                            "type": "array",
                            "maxItems": 10,
                            "items": {
                              "type": "object",
                              "properties": {
                                "url": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2048,
                                  "pattern": "^https?://",
                                  "description": "Absolute http or https URL of the source."
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 200
                                },
                                "source": {
                                  "type": "string",
                                  "enum": [
                                    "slack",
                                    "github",
                                    "other"
                                  ]
                                }
                              },
                              "required": [
                                "url",
                                "label",
                                "source"
                              ]
                            }
                          },
                          "item_refs": {
                            "type": "array",
                            "maxItems": 10,
                            "items": {
                              "type": "object",
                              "properties": {
                                "source": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 32
                                },
                                "external_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256
                                }
                              },
                              "required": [
                                "source",
                                "external_id"
                              ]
                            },
                            "description": "Items this bullet refers to, by the same source and external_id used by push_items."
                          }
                        },
                        "required": [
                          "text"
                        ]
                      }
                    }
                  },
                  "required": [
                    "title",
                    "bullets"
                  ]
                }
              },
              "received_at": {
                "type": "string"
              }
            },
            "required": [
              "briefing_id",
              "date",
              "agent",
              "headline",
              "sections",
              "received_at"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "external_id": {
                  "type": "string"
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "sync",
                    "agent"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string"
                },
                "received_at": {
                  "type": "string",
                  "description": "When drizza last stored this item, from a push or a sync."
                }
              },
              "required": [
                "source",
                "kind",
                "external_id",
                "origin",
                "title",
                "received_at"
              ]
            },
            "description": "Items drizza stored or refreshed during the day, from push_items or from the GitHub sync, newest first, at most 200. The day is read in the local time zone of the machine running drizza. Fields without a value are omitted."
          }
        },
        "required": [
          "date",
          "briefing",
          "items"
        ]
      }
    }
  ]
}
